# =========================================================
# Reflows | Contoh pengaturan
#
# JANGAN ISI BERKAS INI. Ini template yang ikut ter-commit.
# Salin jadi .env.local lalu isi di sana:
#   cp .env.example .env.local
# =========================================================

# ---------- Supabase CLI ----------
# Account Settings, menu Access Tokens, Generate new token. Diawali sbp_
SUPABASE_ACCESS_TOKEN=

# ---------- Koneksi Supabase ----------
# Project Settings, menu Data API
NEXT_PUBLIC_SUPABASE_URL=
# Kunci publik. Memang boleh terlihat di browser, karena yang menjaga data
# adalah Row Level Security, bukan kunci ini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kunci service role. MELEWATI semua Row Level Security. Hanya dipakai
# webhook WhatsApp yang jalan tanpa sesi pengguna. Jangan pernah dipakai di
# komponen browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Claude API ----------
# Menyusul di Fase 2. Ambil di console.anthropic.com, menu API Keys
ANTHROPIC_API_KEY=

# ---------- Gateway WhatsApp ----------
# TIDAK ADA kunci gateway di sini, dan itu disengaja.
#
# Token Fonnte milik masing-masing tenant, bukan milik aplikasi. Token itu
# diisi lewat halaman Pengaturan, disandi, lalu disimpan per tenant di
# database. Kalau ditaruh di sini, semua tenant terpaksa memakai satu nomor
# WhatsApp yang sama.
#
# Rahasia webhook juga tidak di sini. Tiap tenant punya rahasianya sendiri
# yang dibuat otomatis oleh database, dan URL-nya bisa disalin dari halaman
# Pengaturan.

# ---------- Enkripsi ----------
# Kunci penyandi token gateway sebelum masuk database. 32 byte dalam base64.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kalau diganti, token gateway yang sudah tersimpan tidak bisa dibuka lagi.
KUNCI_ENKRIPSI=

# ---------- Antrean kampanye ----------
# Rahasia yang menjaga jalur /api/kampanye/jalan. Jalur itu terbuka di
# internet dan yang memanggilnya pg_cron di Supabase, yang tidak punya sesi
# pengguna. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nilai yang sama harus dipasang juga di Supabase, lihat skrip/pasang-cron.sql
RAHASIA_CRON=

# ---------- Tampilan biaya ----------
# Kurs untuk menampilkan perkiraan rupiah di halaman Penggunaan. Tidak
# pernah dipakai menghitung tagihan. Kosong berarti 16500.
KURS_USD_IDR=

# ---------- Halaman depan ----------
# Nomor WhatsApp yang dihubungi calon pelanggan dari halaman depan, format
# internasional tanpa tanda plus, misalnya 628123456789. Kosong berarti
# tombol chatnya tidak muncul sama sekali dan ajakannya jatuh ke halaman
# masuk. Halaman jualan yang menampilkan nomor karangan lebih buruk
# daripada halaman yang cuma menyuruh masuk.
NEXT_PUBLIC_KONTAK_WA=
